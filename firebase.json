{
  "functions": {
    "source": ".",
    "runtime": "nodejs24"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/auth.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/auth/success",
        "destination": "/auth-success.html"
      },
      {
        "source": "/auth.html",
        "destination": "/auth.html"
      }
    ]
  }
}
