
# =============================================================================
# AMPLIFIER BACKEND ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy values into .env / .env.<projectId> for deploy, or .env.local for the
# emulator. Never commit real .env or .secret.local files.
#
# Sign in with Apple (Firebase Auth) is configured in the Firebase Console /
# Identity Toolkit Apple provider — not via these MusicKit params.
# Use a SIWA-capable Apple key there (separate from MusicKit).

# Apple Sign-In (reference only — set in Firebase Auth → Apple provider)
# Services ID:
APPLE_CLIENT_ID=house.icy.amplemusic.service
# Do not put the SIWA .p8 or client-secret JWT in git. Firebase stores the
# Team ID / Key ID / private key on the Apple provider config.

# Apple Music / MusicKit (Firebase Functions params + secret)
APPLE_MUSIC_KEY_ID=your_musickit_key_id
# Apple Developer Team ID — also used as MusicKit JWT `iss` (do not set a separate issuer)
APPLE_MUSIC_TEAM_ID=A39UD833JS

# MusicKit .p8 only — set via:
#   firebase functions:secrets:set APPLE_MUSIC_PRIVATE_KEY
# Emulator: PEM in .secret.local as APPLE_MUSIC_PRIVATE_KEY=...
# Do not use the Sign in with Apple .p8 here.

# Firebase Configuration
AMPLIFIER_PROJECT_ID=amplemusic-prod
